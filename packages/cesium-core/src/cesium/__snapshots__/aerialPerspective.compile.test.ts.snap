exports[`月盘 MOON 段（spec r2 §5） > moon=false golden：产物与现状（无 moon 代码）逐字符一致 > moon-off-golden 1`] = `
"precision highp float;
precision highp sampler3D;
#define PI 3.14159265358979323846
#define TRANSMITTANCE_TEXTURE_WIDTH 256
#define TRANSMITTANCE_TEXTURE_HEIGHT 64
#define SCATTERING_TEXTURE_R_SIZE 32
#define SCATTERING_TEXTURE_MU_SIZE 128
#define SCATTERING_TEXTURE_MU_S_SIZE 32
#define SCATTERING_TEXTURE_NU_SIZE 8
#define IRRADIANCE_TEXTURE_WIDTH 64
#define IRRADIANCE_TEXTURE_HEIGHT 16
#define METER_TO_LENGTH_UNIT 0.0010000
#define COMBINED_SCATTERING_TEXTURES
#define HAS_HIGHER_ORDER_SCATTERING_TEXTURE
// Based on: https://github.com/ebruneton/precomputed_atmospheric_scattering/blob/master/atmosphere/definitions.glsl

/**
